# GFTSH 10-WALLET LIVE OBSERVER
# Put these in GitHub Actions -> Settings -> Environments -> production -> Variables/Secrets.

# =========================
# REQUIRED SECRETS
# =========================

# Telegram bot token — SECRET
TELEGRAM_TOKEN=

# Telegram chat/channel ID — SECRET
TELEGRAM_CHAT_ID=

# =========================
# OPTIONAL VARIABLES
# =========================

HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info

# The workflow should run every 15 minutes.
GFTSH_SCAN_INTERVAL_MIN=15

# API fill window. Keep slightly larger than scan interval so a delayed run
# does not miss a fill. Deduplication prevents duplicate Telegram alerts.
GFTSH_LOOKBACK_MIN=20

GFTSH_REQUEST_GAP_MS=250
GFTSH_REQUEST_TIMEOUT_MS=15000
GFTSH_RETRIES=3
GFTSH_RETRY_BASE_MS=500

# Persisted state.
GFTSH_WATCH_STATE_FILE=production/state/gftsh_10_wallet_observer.json
GFTSH_WATCH_TELEGRAM_STATE_FILE=production/state/gftsh_10_wallet_telegram.json

# Model TP/SL used only when the trader's own public TP/SL is not exposed.
GFTSH_MODEL_SL_PCT=0.5
GFTSH_MODEL_TP_R=2

# Ignore tiny fills.
GFTSH_MIN_ALERT_NOTIONAL_USD=50

# Telegram safety limit.
GFTSH_TELEGRAM_MAX_CHARS=3800

# Send the one-time startup/watch message.
GFTSH_SEND_STARTUP_STATUS=true

# =========================
# OPTIONAL — REPLACE THE 10 WATCHED WALLETS
# =========================
# Format:
# Trader #1|0x....
# Trader #2|0x....
# ...
# all 10 comma-separated on one line.
#
# Leave empty to use the 10 wallets hard-coded in the JS file.
GFTSH_WATCH_WALLETS=
